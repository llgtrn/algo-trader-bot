# algo-trader-bot — environment template (copy to repo-root .env)

# ── cTrader (Open API) ────────────────────────────────────────────────
CLIENT_ID=
CLIENT_SECRET=
ACCESS_TOKEN=
ACCOUNT_ID=
HOST=demo                       # demo (TCP 5035) until proven; live = TCP 5034
# LIVE_CONFIRMED=1              # required to allow HOST=live (gated)

# ── Telegram ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Daemon / risk ─────────────────────────────────────────────────────
HEARTBEAT_SECONDS=300
WATCHLIST=EURUSD,GBPUSD,XAUUSD
MAX_LOTS=                       # 0/blank = not enforced this phase
MAX_POSITIONS=
MAX_DAILY_LOSS=
KILL_SWITCH_FILE=./HALT         # touch this file to stop new orders

# ── Stance bus ────────────────────────────────────────────────────────
STANCE_STORE=sqlite             # sqlite | drive | git | kv
STANCE_DB_PATH=./algo-trader-bot.db

# ── Brain (TradingAgents .propagate path) ─────────────────────────────
# Required only when running the brain (python -m brain.run_analysis).
# TRADINGAGENTS_LLM_PROVIDER=anthropic
# TRADINGAGENTS_DEEP_THINK_LLM=claude-opus-4
# TRADINGAGENTS_QUICK_THINK_LLM=claude-haiku-4
# ANTHROPIC_API_KEY=
# Brain cadence is set in the scheduler/cron, e.g. 0 * * * * (hourly).
